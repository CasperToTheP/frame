[Unit]
Description=Frame artwork player (supervised fullscreen mpv)
Documentation=https://github.com/CasperToTheP/frame
# The player owns the HDMI screen; keep the login prompt off it.
Conflicts=getty@tty1.service
After=systemd-tmpfiles-setup.service sound.target local-fs.target
Wants=sound.target
# The supervisor backs off internally (1s..60s) and systemd adds RestartSec on
# top, so a permanently broken setup retries slowly instead of spinning. It
# never gives up: an art frame should heal itself once the fault goes away.
StartLimitIntervalSec=0

[Service]
Type=simple
User=frame
Group=frame
SupplementaryGroups=video render audio
EnvironmentFile=-/etc/default/frame
Environment=PYTHONUNBUFFERED=1 HOME=/var/lib/frame
WorkingDirectory=/var/lib/frame
ExecStart=/opt/frame/venv/bin/python -m frame.player_service
Restart=always
RestartSec=5
# Stop mpv along with the supervisor.
KillMode=control-group
TimeoutStopSec=10
# Exit code 75: mpv is stuck in the kernel because the graphics firmware hung,
# and only a reboot recovers. The supervisor limits how often it asks for this
# (see REBOOT_EXIT_CODE in player_service.py). "+" runs it as root, unsandboxed.
ExecStopPost=+/bin/sh -c 'if [ "$$EXIT_STATUS" = 75 ]; then echo "frame-player: rebooting to recover from a graphics hang"; exec systemctl --no-block reboot; fi'
# Smooth playback beats everything else on this box.
Nice=-5

# Hardening (mpv needs /dev/dri and /dev/snd, so devices stay visible).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/frame /run/frame
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
