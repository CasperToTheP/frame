[Unit]
Description=Frame Wi-Fi fallback (own hotspot when the home Wi-Fi is out of reach)
Documentation=https://github.com/CasperToTheP/frame
After=NetworkManager.service systemd-tmpfiles-setup.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Root: switching Wi-Fi between the home network and the hotspot needs it.
# It only ever runs nmcli and iw, and never imports Flask.
EnvironmentFile=-/etc/default/frame
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/frame/venv/bin/python -m frame.netwatch
Restart=always
RestartSec=10
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/frame
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
