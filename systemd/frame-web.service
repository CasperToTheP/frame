[Unit]
Description=Frame web management UI (port 8080)
Documentation=https://github.com/CasperToTheP/frame
# Binds to 0.0.0.0, so it does not need to wait for Wi-Fi to come up.
After=network.target systemd-tmpfiles-setup.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=frame
Group=frame
EnvironmentFile=-/etc/default/frame
# Large uploads are buffered on the SD card, never in RAM (/tmp may be tmpfs).
Environment=PYTHONUNBUFFERED=1 HOME=/var/lib/frame TMPDIR=/var/lib/frame/tmp
WorkingDirectory=/var/lib/frame
ExecStart=/opt/frame/venv/bin/python -m frame.web
Restart=always
RestartSec=3
# Leave room for the player if something goes wrong in the web app.
MemoryMax=250M
Nice=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/frame /run/frame
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
